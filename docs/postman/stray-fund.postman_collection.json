    },
    {
      "name": "Caretaker (demo session)",
      "description": "One route runs every desk action. Valid action names: payout_approve, payout_reject, payout_resolve, payout_note, payout_allow_retry, evidence_accept, evidence_confirm_ear_tip, evidence_reject, review_resolve, sighting_confirm_new, sighting_merge, sighting_reject, cat_set_details, cat_set_ear_tip, cat_rename, name_approve, name_dismiss, cat_undo_neutered, cat_adoptable, cat_adopted, photo_publish, photo_hold, guardrails_update, payee_add, payee_remove, vet_update, wakeup_retry, wakeup_dismiss. Each takes its own JSON body; see src/server/caretaker/*.ts.",
      "item": [
        {
          "name": "Run a caretaker action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/caretaker/{{action}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "caretaker",
                "{{action}}"
              ]
            },
            "description": "Auth: Needs a session cookie as the demo caretaker (POST /api/session with persona caretaker). Demo mode only.\n\nBody depends on the action. The example is for cat_adoptable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"catId\": \"{{catId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Private image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/caretaker/images/eartip/{{receiptId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "caretaker",
                "images",
                "eartip",
                "{{receiptId}}"
              ]
            },
            "description": "Auth: Needs a session cookie as the demo caretaker (POST /api/session with persona caretaker). Demo mode only. A vet session works for the vet's own booking.\n\nkind is receipt, eartip or sighting. In demo mode non-seeded originals show a placeholder."
          }
        }
      ]
    },
    {
      "name": "Vet (demo session)",
      "item": [
        {
          "name": "Confirm a booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vet/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vet",
                "bookings"
              ]
            },
            "description": "Auth: Needs a session cookie as the demo vet (POST /api/session with persona vet). Demo mode only.\n\ndate is YYYY-MM-DD in Manila.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"catId\": \"{{catId}}\",\n  \"date\": \"2026-11-10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send receipt and ear photo",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vet/bookings/{{bookingId}}/evidence",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vet",
                "bookings",
                "{{bookingId}}",
                "evidence"
              ]
            },
            "description": "Auth: Needs a session cookie as the demo vet (POST /api/session with persona vet). Demo mode only.\n\nMultipart. receipt is JPEG or PNG. earTipPhoto is a JPEG.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "receipt",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "earTipPhoto",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Device and PayPal",
      "item": [
        {
          "name": "Feeder meal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{feederToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/feeder/meal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "feeder",
                "meal"
              ]
            },
            "description": "Auth: Bearer token equal to the server's FEEDER_TOKEN. Not a user session.\n\nAt most one meal is recorded a minute.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"feeder\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PayPal webhook (PayPal calls this)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/paypal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "paypal"
              ]
            },
            "description": "Auth: WEBHOOK. Signed by PayPal. The app verifies the signature with PAYPAL_WEBHOOK_ID. Do not call it by hand: an unsigned request is answered 400.\n\nReal events come from PayPal's dashboard webhook. This request exists to show the route and to confirm it rejects unsigned calls.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-EXAMPLE\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
