              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cats/{{catId}}/sex",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cats",
                "{{catId}}",
                "sex"
              ]
            },
            "description": "Auth: Needs a session cookie from POST /api/session (any signed-in role). Postman keeps the cookie.\n\nanswer is female or male.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answer\": \"female\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
