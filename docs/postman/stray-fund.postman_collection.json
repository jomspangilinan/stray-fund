{
  "info": {
    "name": "Stray Fund (draft)",
    "description": "Routes of the Stray Fund app, from src/app/api. No secrets: set baseUrl to your own server. Sign in first with the Session folder; Postman keeps the cookie. Sandbox money only. PayPal's own API is not in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "catId",
      "value": "",
      "description": "A cat id from GET /api/ledger or the cat page URL."
    },
    {
      "key": "orderId",
      "value": "",
      "description": "PayPal order id returned by POST /api/donations."
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "receiptId",
      "value": ""
    },
    {
      "key": "payoutId",
      "value": ""
    },
    {
      "key": "sightingId",
      "value": ""
    },
    {
      "key": "action",
      "value": "cat_adoptable",
      "description": "A caretaker action name. See the folder description."
    },
    {
      "key": "feederToken",
      "value": "",
      "description": "Set in your own environment. Never commit it."
    }
  ],
  "item": [
    {
      "name": "Session",
      "item": [
        {
          "name": "Get session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "session"
              ]
            },
            "description": "Auth: Public. No sign-in.\n\n"
          }
        },
        {
          "name": "Sign in as a donor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "session"
              ]
            },
            "description": "Auth: Public. No sign-in.\n\nCreates the user if the name is free. Sets the session cookie.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"your_name\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Switch demo role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "session"
              ]
            },
            "description": "Auth: Demo session. Only works when the server has DEMO_MODE=true.\n\npersona is neighbour, caretaker or vet (see src/server/session.ts PERSONAS).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"persona\": \"caretaker\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sign out",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "session"
              ]
            },
            "description": "Auth: Public. No sign-in.\n\n"
          }
        }
      ]
    },
