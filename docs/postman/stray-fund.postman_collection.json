    },
    {
      "name": "Neighbour (demo session)",
      "item": [
        {
          "name": "Create donation order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/donations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "donations"
              ]
            },
            "description": "Auth: Needs a session cookie from POST /api/session (any signed-in role). Postman keeps the cookie.\n\namount is in centavos (10000 is PHP 100). attemptId is a new UUID per tap. Returns orderId. Approve it as a PayPal sandbox buyer, then capture.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000,\n  \"attemptId\": \"00000000-0000-4000-8000-000000000001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Capture donation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/donations/{{orderId}}/capture",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "donations",
                "{{orderId}}",
                "capture"
              ]
            },
            "description": "Auth: Needs a session cookie from POST /api/session (any signed-in role). Postman keeps the cookie.\n\n"
          }
        },
        {
          "name": "Spot a cat",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/spot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "spot"
              ]
            },
            "description": "Auth: Needs a session cookie from POST /api/session (any signed-in role). Postman keeps the cookie.\n\nMultipart. photo is a JPEG from the live camera. lat and lng are optional and come as a pair.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "lat",
                  "value": "",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "lng",
                  "value": "",
                  "type": "text",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Answer ear-tip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cats/{{catId}}/ear-tip",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cats",
                "{{catId}}",
                "ear-tip"
              ]
            },
            "description": "Auth: Needs a session cookie from POST /api/session (any signed-in role). Postman keeps the cookie.\n\nanswer is yes, no or unsure.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answer\": \"yes\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Answer sex",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
