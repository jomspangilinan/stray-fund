# Postgres connection string for the app (Render injects this in production)
# NODE_ENV is set by the tools locally. Render sets it to production on web and worker (see render.yaml).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/strayfund_dev
# Postgres connection string used by `npm test`
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/strayfund_test
# "true" enables demo mode (simulated payments and fixtures)
DEMO_MODE=true
# PayPal REST credentials for payouts, read at call time
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "production" uses live PayPal; anything else uses the sandbox
PAYPAL_ENV=sandbox
# Signs the session cookie (HS256). Required, at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=
# Vet payout address for the demo persona (a sandbox account in sandbox mode)
PAYPAL_VET_EMAIL=
# Webhook id from the PayPal developer dashboard. Webhooks are rejected without it.
PAYPAL_WEBHOOK_ID=
# Photo storage driver: s3, local or memory. Defaults to s3 in production, local in development, memory in tests.
# Production refuses anything but s3. "local" writes under .data/ and serves public files at /api/dev-photos/.
STORAGE_DRIVER=
AWS_REGION=ap-southeast-1
# Vision provider: claude-cli (local development only, uses your Claude subscription through `claude -p`)
# or bedrock (always used in production, refuses anything else). Defaults to claude-cli outside production.
AI_PROVIDER=
# The treasurer agent (npm run worker) always uses Bedrock, whatever AI_PROVIDER says, because it needs tool calls.
# Bedrock model id. Defaults to global.anthropic.claude-haiku-4-5-20251001-v1:0
AI_MODEL=
# Model alias passed to `claude --model` on the claude-cli route. Defaults to haiku.
AI_CLI_MODEL=
# Locally, set AWS_PROFILE to an `aws login` profile and Bedrock keys are fetched through the AWS CLI.
# In production use the standard AWS credential chain (env keys or an IAM role). Never shells out there.
# AWS_PROFILE=your-profile
# Access key of the limited IAM user for S3 and Bedrock (production, web and worker). Locally the profile above is enough.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Daily cap on AI calls for both providers (default 500)
AI_DAILY_CALL_CAP=
# Private bucket for original photos (block all public access, no public route reads it)
S3_PRIVATE_BUCKET=
# Public bucket (or CDN origin) for scrubbed photos
S3_PUBLIC_BUCKET=
# Base URL that serves the public bucket, e.g. https://BUCKET.s3.ap-southeast-1.amazonaws.com
S3_PUBLIC_BASE_URL=
# Shared secret for POST /api/feeder/meal (Authorization: Bearer <token>). Unset means the route rejects everything.
FEEDER_TOKEN=
