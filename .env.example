# Postgres connection string for the app (Render injects this in production)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/strayfund_dev
# Postgres connection string used by `npm test`
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/strayfund_test
# "true" enables demo mode (simulated payments and fixtures)
DEMO_MODE=true
# PayPal REST credentials for payouts, read at call time
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "production" uses live PayPal; anything else uses the sandbox
PAYPAL_ENV=sandbox
# Signs the session cookie (HS256). Required, at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=
# Vet payout address for the demo persona (a sandbox account in sandbox mode)
PAYPAL_VET_EMAIL=
# Webhook id from the PayPal developer dashboard. Webhooks are rejected without it.
PAYPAL_WEBHOOK_ID=
